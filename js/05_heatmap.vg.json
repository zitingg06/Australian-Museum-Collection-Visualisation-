{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
        "url": "https://raw.githubusercontent.com/zitingg06/Australian-Museum-Collection-Visualisation-/refs/heads/main/data/nma_collections.csv"
    },
    "width": "container",
    "height": 300,
    "transform": [
        {
            "joinaggregate":[{"op": "count", "as": "category_total"}],
            "groupby":["category_group"]
        },
        {
            "aggregate":[{"op": "count", "as": "records"}, {"op": "max", "field": "category_total", "as": "category_total"}],
            "groupby":["category_group", "material_family"]
        },
        {
            "calculate": "datum.records / datum.category_total * 100", "as": "percent"
        }
    ],
    "params": [{"name": "highlight", "select": "point"}],
    "mark": {
        "type" : "rect"
    },
    "encoding": {
        "x": {
            "field": "category_group",
            "type": "ordinal",
            "title": "Category",
            "axis":{"labelAngle": -35}
        },
        "y": {
            "field": "material_family",
            "type": "ordinal",
            "title": "Material Family"
        },
        "color": {
            "field": "percent",
            "type": "quantitative",
            "title": "Records (%)",
            "scale":{
                "domain": [0, 100],
                "scheme": "tealblues"
            }
        },
        "opacity": {
            "condition": {"param": "highlight", "value": 1},
            "value": 0.3
        },
        "tooltip": [
            {"field": "category_group", "title": "Category"},
            {"field": "material_family","title": "Material Family"},
            {"field": "records","title": "Records","format": "d"},
            {"field": "category_total","title": "Category Total","format": "d"},
            {"field": "percent","title": "%","format": ".1f"}
        ]
    },
    "config": {
        "view": {"stroke": "null"},
        "axis": {
            "titleFont": "Plus Jakarta Sans",
            "titleFontWeight": "bold",
            "titlePadding": 12,
            "labelFont": "Plus Jakarta Sans",
            "labelFontSize": 10,
            "labelPadding": 12
        },
        "legend": {
            "orient": "right",
            "titleFont": "Playfair Display", "titleFontWeight": "bold", "titleFontSize": 13, "titleColor":"#0D2B80",
            "labelFont": "Plus Jakarta Sans", "labelFontSize": 11, "labelColor":"#0D2B80"
        }
    }
}