{
    "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
        "url": "https://raw.githubusercontent.com/zitingg06/Australian-Museum-Collection-Visualisation-/refs/heads/main/data/commemorative_coins_stamps.csv"
    },
    "width": "container",
    "height": 300,
        "params": [
        {
            "name": "Theme_selection",
            "bind": {
                "input": "select",
                "options": [
                    null,
                    "Arts & Culture",
                    "Australian History",
                    "Environment",
                    "First Nations",
                    "Military",
                    "Royalty",
                    "Sport",
                    "Transport & Exploration"
                ],
                "labels": [
                    "Show All",
                    "Arts & Culture",
                    "Australian History",
                    "Environment",
                    "First Nations",
                    "Military",
                    "Royalty",
                    "Sport",
                    "Transport & Exploration"
                ],
                "name": "Theme Selection: "
            }
        }
    ],
    "transform": [
        {"filter": "datum.type == 'Coin' && isValid(datum.year) && isValid(datum.mintage)"},
        {"filter": "Theme_selection == null || datum.theme == Theme_selection"}
    ],
    "layer":[
        {
            "transform":[
                {
                    "regression": "mintage",
                    "on": "year",
                    "method": "linear"
                }
            ],
            "mark": {
                "type": "line",
                "color": "#253B66",
                "strokeWidth": 2.5
            },
            "encoding": {
                "x": {
                    "field": "year",
                    "type": "quantitative",
                    "title": "Issue Year"
                },
                "y": {
                    "field": "mintage",
                    "type": "quantitative",
                    "title": "Mintage"
                }
            }
        },
        {
            "mark": {
                "type": "point",
                "filled": true,
                "size": 200,
                "stroke":"#0D2B80",
                "strokeWidth": 1.5
            },
            "encoding": {
                "x": {
                    "field": "year",
                    "type": "quantitative",
                    "scale":{"zero": false},
                    "axis": {
                        "format": "d",
                        "tickCount": 5
                        
                    }
                },
                "y": {
                    "field": "mintage",
                    "type": "quantitative",
                    "axis": {
                        "tickCount": 5
                    }
                },
                "color" : {
                    "field": "theme",
                    "type": "nominal",
                    "title": "Commemorative theme",
                    "scale": {"range":["#4F78A8", "#0B1F5B", "#77A6B8", "#A96F50", "#E6B93F", "#24478F", "#D99A32", "#71809A","#A9C7C2"]},
                    "legend": {"orient": "bottom"}
                },
                "tooltip": [
                    {"field":"title", "type": "nominal", "title": "Issue"},
                    {"field":"year", "type": "quantitative", "title": "Year", "format": "d"},
                    {"field":"mintage", "type": "quantitative", "title": "Mintage", "format": ",.1f"},
                    {"field":"theme", "type": "nominal", "title": "Theme"}
                ]
            }
        }
    ],
    "config":{
        "view":{"stroke":null},
        "axis": {
            "titleFont": "Plus Jakarta Sans",
            "titleFontWeight": "bold",
            "titlePadding": 12,
            "labelFont": "Plus Jakarta Sans",
            "labelFontSize": 10,
            "labelPadding": 12
        },
        "legend":{
            "titleFont": "Playfair Display",
            "titleFontWeight": "bold", "titleFontSize": 13, "titleColor":"#0D2B80",
            "labelFont": "Plus Jakarta Sans", "labelFontSize": 11, "labelColor":"#0D2B80",
            "symbolSize": 200, "symbolStrokeWidth": 2
        }
    }
}