{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
        "url": "https://raw.githubusercontent.com/zitingg06/Australian-Museum-Collection-Visualisation-/refs/heads/main/data/nma_collections.csv"
    },
    "width": "container",
    "height": 300,
    "params": [
        {
            "name": "Year_filter",
            "value": 0,
            "bind": {
                "input": "range",
                "min": 1750,
                "max": 2022,
                "step": 1,
                "name": "Year Selection: "
            }
        }
    ],
    "transform": [
        {"filter": "datum.year != null && datum.year > 1700"},
        {"filter": "datum.year > Year_filter"}
    ],
    "mark":{
        "type": "area",
        "interpolate":"basis",
        "color": "#FFFFFF",
        "stroke":"#0D2B80",
        "strokeWidth": 1.5
    },
    "encoding": {
        "x": {
            "field" : "year",
            "type" : "quantitative",
            "title": "Year",
            "axis":{"format": "d"}
        },
        "y":{
            "aggregate" : "count",
            "type" : "quantitative",
            "stack" : "center",
            "title": "Number of Recorded Collectibles"
        },
        "color": {
            "field": "category_group",
            "type": "nominal",
            "title": "Category Group",
            "scale":{
                "range": ["#152A7B", "#1A33A0", "#F7CC4F", "#97A2B6", "#4A5567", "#F8D767"]
            }
        }
    },
    "config":{
        "view": { "stroke": null},
        "axis": {
            "titleFont": "Plus Jakarta Sans", "titleFontWeight": "bold", "titlePadding": 12, 
            "labelFont": "Plus Jakarta Sans", "labelFontSize": 10, "labelPadding": 12
        },
        "legend": {
            "orient": "right",
            "titleFont": "Playfair Display", "titleFontWeight": "bold", "titleFontSize": 13, "titleColor":"#0D2B80",
            "labelFont": "Plus Jakarta Sans", "labelFontSize": 11, "labelColor":"#0D2B80",
            "symbolSize": 200, "symbolStrokeWidth": 2
        }
    }
}
