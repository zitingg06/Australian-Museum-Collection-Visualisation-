{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
        "url": "https://raw.githubusercontent.com/zitingg06/Australian-Museum-Collection-Visualisation-/refs/heads/main/data/nma_collections.csv"
    },
    "width": "container",
    "height": 300,
    "params": [
        {
            "name": "Category_selection",
            "bind": {
                "input": "select",
                "options": [
                    null,
                    "Banknotes",
                    "Coins",
                    "Medals",
                    "Stamps",
                    "Tokens",
                    "Other"
                ],
                "labels": [
                    "Show All",
                    "Banknotes",
                    "Coins",
                    "Medals",
                    "Stamps",
                    "Tokens",
                    "Other"
                ],
                "name": "Category Selection: "
            }
        }
    ],
    "transform": [
        {
        "filter": "Category_selection == null || datum.category_group == Category_selection"
        }
    ],
    "mark":{
        "type": "arc",
        "innerRadius": 70,
        "color": "#FFFFFF",
        "stroke":"#0D2B80",
        "strokeWidth": 1.5
    },
    "encoding": {
        "theta": {
            "aggregate": "count",
            "type": "quantitative",
            "title": "Number of items"
        },
        "color": {
            "field": "category_group",
            "type": "nominal",
            "title": "Category",
            "scale":{
                "range": ["#152A7B", "#1A33A0", "#F7CC4F", "#97A2B6", "#4A5567", "#F8D767"]
            }
        },
        "order":{
            "aggregate": "count",
            "type": "quantitative",
            "sort": "ascending"
        },
        "tooltip": [
            {"field": "category_group", "type": "nominal", "title": "category"},
            {"aggregate": "count", "type": "quantitative", "title": "Items"}
        ]
    },
    "config":{
        "view": { "stroke": null},
        "legend": {
            "orient": "right",
            "titleFont": "Playfair Display", "titleFontWeight": "bold", "titleFontSize": 13, "titleColor":"#0D2B80",
            "labelFont": "Plus Jakarta Sans", "labelFontSize": 11, "labelColor":"#0D2B80",
            "symbolSize": 200, "symbolStrokeWidth": 2
        }
    }
}
