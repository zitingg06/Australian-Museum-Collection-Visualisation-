{
    "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
        "url": "https://raw.githubusercontent.com/zitingg06/Australian-Museum-Collection-Visualisation-/refs/heads/main/data/commemorative_coins_stamps.csv"
    },
    "width": "container",
    "height": 300,
    "params": [
        {
            "name": "Year_filter",
            "value": 0,
            "bind": {
                "input": "range",
                "min": 1970,
                "max": 2026,
                "step": 1,
                "name": "Year Selection: "
            }
        }
    ],
     "transform": [
        {"filter": "datum.year > Year_filter"}
    ],
    "mark": {
        "type": "point",
        "filled": true,
        "size": 200,
        "stroke":"#0D2B80",
        "strokeWidth": 1.5
    },
    "encoding":{
        "x":{
            "field": "year",
            "type": "quantitative",
            "title": "Issue year",
            "scale": {"domain": [1940, 2030]},
            "axis": {
                "format": "d",
                "tickCount": 5
            }
        },
        "y":{
            "field": "theme",
            "type": "nominal",
            "title": "Commemorative theme",
            "sort": "-x",
            "axis": {
                "labelLimit": 170
            }
        },
        "color": {
            "field": "type",
            "type": "nominal",
            "title": "Collectible type",
            "scale":{
                "domain": ["Coin", "Stamp"],
                "range": ["#1A33A0", "#4A5567"]
            }
        },
        "tooltip": [
            {"field": "title", "type": "nominal", "title": "Issue"},
            {"field": "year", "type": "quantitative", "title": "Year", "format": "d"},
            {"field": "theme", "type": "nominal", "title": "Theme"},
            {"field": "type", "type": "nominal", "title": "Type"},
            {"field": "denomination", "type": "nominal", "title": "Denomination"}
        ]
    },
    "config": {
        "view": {"stroke": null},
        "axis": {
            "titleFont": "Plus Jakarta Sans",
            "titleFontWeight": "bold",
            "titlePadding": 12,
            "labelFont": "Plus Jakarta Sans",
            "labelFontSize": 10,
            "labelPadding": 12
        },
        "legend":{
            "orient": "right",
            "titleFont": "Playfair Display", "titleFontWeight": "bold", "titleFontSize": 13, "titleColor":"#0D2B80",
            "labelFont": "Plus Jakarta Sans", "labelFontSize": 11, "labelColor":"#0D2B80",
            "symbolSize": 200, "symbolStrokeWidth": 2
        }
    }
}