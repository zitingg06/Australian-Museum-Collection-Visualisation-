{
    "$schema":"https://vega.github.io/schema/vega-lite/v5.json",
    "data": {
        "url": "https://raw.githubusercontent.com/zitingg06/Australian-Museum-Collection-Visualisation-/refs/heads/main/data/nma_collections.csv"
    },
    "width": "container",
    "height": 300,
    "transform": [
        {"filter": "isValid(datum.category_group) && isValid(datum.era)"},
        {"calculate": "replace(datum.era, /[–—−]/g, '-')", "as": "era_clean"},
        {
            "calculate": "datum.era_clean == 'Pre-1788' || datum.era_clean == '1788-1900' ? 'Pre-Federation (Pre-1901)' : test(/^(1966|2000|2010|2020)/, datum.era_clean) ? 'Modern (Post-1966)' : null",
            "as": "period" 
        },
        {"filter": "isValid(datum.period)"},
        {
            "aggregate": [{"op": "count", "as": "records"}],
            "groupby": ["category_group", "period"]
        },
        {
            "joinaggregate": [{"op": "sum", "field": "records", "as": "period_total"}],
            "groupby" : ["period"]
        },
        {"calculate": "datum.records / datum.period_total * 100", "as": "share"},
        {
            "calculate": "datum.period == 'Pre-Federation (Pre-1901)' ? -datum.share: datum.share",
            "as" : "signed_share"
        }
    ],
    "layer": [
        { 
            "mark": {
                "type": "bar", 
                "cornerRadius": 3,
                "stroke": "#0D2B80",
                "strokeWidth": 2,
                "tooltip": true
            },
            "encoding": {
                "x": {
                    "field": "signed_share",
                    "type": "quantitative",
                    "title": "Pre-Federation share (%)    |    Modern share (%)"
                },
                "y": {
                    "field": "category_group",
                    "type": "nominal",
                    "title": "Category"
                },
                "color": {
                    "field": "period",
                    "type": "nominal",
                    "title": "Historical period",
                    "scale": {
                        "domain": ["Pre-Federation (Pre-1901)", "Modern (Post-1966)"],
                        "range": ["#0B1F5B", "#F7C928"]
                    }
                },
                "tooltip": [
                    {"field": "category_group", "type": "nominal", "title": "Category"},
                    {"field": "period", "type": "nominal", "title": "Period"},
                    {"field": "share", "type": "quantitative", "title": "Share of period records (%)", "format": ".1f"},
                    {"field": "records", "type": "quantitative", "title": "NMA records", "format": ",.0f"}
                ]
            }
        },
        {
            "mark": {"type": "rule", "color": "#FFFFFF", "strokeWidth": 1.5},
            "encoding": {"x": {"datum": 0}}
        }
    ],
    "config": {
        "view": {"stroke": null},
        "axis": {
            "titleFont": "Plus Jakarta Sans", "titleFontWeight": "bold", "titlePadding": 12,
            "labelFont": "Plus Jakarta Sans", "labelFontSize": 10,  "labelPadding": 12
        },
        "legend":{
            "orient": "right",
            "titleFont": "Playfair Display", "titleFontWeight": "bold", "titleFontSize": 13, "titleColor":"#0D2B80",
            "labelFont": "Plus Jakarta Sans", "labelFontSize": 11, "labelColor":"#0D2B80", "labelLimit": 135
        }
    }
}