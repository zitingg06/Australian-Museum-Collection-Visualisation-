{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": "container",
    "height": 420,
    "projection": {
        "type": "equalEarth"
    },
    "data": { 
        "url": "https://raw.githubusercontent.com/zitingg06/Australian-Museum-Collection-Visualisation-/refs/heads/main/data/nma_production_places.csv"
    },
    "transform": [
        {"filter": "datum.location_scope == 'Outside Australia' && isValid(datum.latitude)"},
        {"aggregate": [
                {"op": "count", "as": "records"},
                {"op": "min", "field": "place_name", "as": "place"}
            ],
            "groupby": ["latitude", "longitude"]
        },
        {"calculate": "{type: 'LineString', coordinates: [[datum.longitude, datum.latitude], [149.13, -35.28]]}", "as": "line"}
    ],
    "layer":[
        {
            "data": {
                "url": "https://raw.githubusercontent.com/zitingg06/Australian-Museum-Collection-Visualisation-/refs/heads/main/js/ne_110m_admin_0_countries.json",
                "format": {"type": "topojson", "feature": "ne_110m_admin_0_countries"}
            },
            "mark":{
                "type": "geoshape",
                "fill": "#F4E8C1",
                "stroke": "white"
            }
        },
        {
            "mark":{
                "type": "geoshape",
                "filled": false,
                "stroke": "#0D2B80",
                "opacity": 0.55
            },
            "encoding": {
                "shape": {"field": "line","type": "geojson"},
                "strokeWidth": {
                    "field": "records", "type": "quantitative", "title": "Records",
                    "scale": {"type": "sqrt", "domain": [1,100], "range": [0.8, 8]},
                    "legend": {
                        "type": "symbol",
                        "symbolType": "stroke",
                        "symbolSize": 300,
                        "values": [1, 10, 50, 100]
                    }
                },
                "tooltip":[
                    {"field": "place", "title":"Place"},
                    {"field": "records", "title": "Records"}
                ]
            }
        },
        {
            "mark": {
                "type": "circle",
                "color": "#0D2B80",
                "size": 30
            },
            "encoding": {
                "longitude": {"field": "longitude", "type": "quantitative"},
                "latitude": {"field": "latitude", "type": "quantitative"}
            }
        },
        {
            "data": {"values": [{"car_longitude": 149.13, "car_latitude": -35.28}]},
            "mark": {
                "type": "circle",
                "color": "#E6B93F", 
                "stroke": "#0D2B80",
                "strokeWidth": 1.5,
                "size": 150
            },
            "encoding": {
                "longitude": {"field": "car_longitude", "type": "quantitative"},
                "latitude": {"field": "car_latitude", "type": "quantitative"}
            }
        }
    ],
    "config":{
        "view": {"stroke": null},
        "legend": {
            "orient": "right",
            "titleFont": "Playfair Display", "titleFontWeight": "bold", "titleFontSize": 13, "titleColor":"#0D2B80",
            "labelFont": "Plus Jakarta Sans","labelFontSize": 11, "labelColor":"#0D2B80"
        }
    }
}